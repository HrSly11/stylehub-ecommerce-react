{
  "name": "stylehub-ecommerce-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "db:init": "node server/test-db.js",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:unit": "jest tests/unit --config jest.config.cjs",
    "test:integration": "jest tests/integration --config jest.config.cjs --runInBand",
    "test:e2e": "cypress run --config-file cypress.config.cjs",
    "test:e2e:open": "cypress open --config-file cypress.config.cjs",
    "test:load": "artillery run load-test.yml",
    "test:load:checkout": "artillery run artillery-checkout-test.yml",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dompurify": "^3.4.15",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsdom": "^30.0.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.460.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0",
    "zod": "^4.5.4"
  },
  "overrides": {
    "qs": "^6.16.0",
    "proxy-addr": "^2.0.8"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "artillery": "^2.0.34",
    "babel-jest": "^30.5.0",
    "cross-env": "^10.1.0",
    "cypress": "^15.21.1",
    "docx": "^9.7.1",
    "jest": "^30.5.0",
    "supertest": "^7.2.2",
    "vite": "^6.0.3"
  }
}
